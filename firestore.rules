rules_version = '2';

// 숙제보드 Firestore Security Rules
// - users/{uid} 이하 데이터는 로그인한 본인(request.auth.uid == uid)만 읽고 쓸 수 있다.
// - 화면에서 버튼을 숨기는 것과 별개로, 허용되지 않은 요청은 여기서 거절된다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidCharacter(data) {
      return data.keys().hasOnly(['gameId', 'name', 'createdAt'])
        && data.gameId in ['maplestory', 'trickcal']
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 20
        && data.createdAt is timestamp;
    }

    // 횟수형 숙제의 최대 횟수 (src/domain/game/games.ts 와 같은 값으로 유지)
    // 목록에 없는 숙제: 체크형은 0/1, 값 기록형은 count 0 만 허용
    function maxCountFor(taskId) {
      return {'theme-dungeon': 20, 'big-candy': 10, 'schedule-10': 10, 'shop-12': 12, 'candyreceive-5': 5, 'login-3': 3}.get(taskId, 1);
    }

    function isValidCheck(data, checkId) {
      return data.keys().hasOnly(['taskId', 'periodKey', 'count', 'value', 'updatedAt'])
        && data.taskId is string
        && data.periodKey is string
        && data.periodKey.matches('^[DW][0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && checkId == data.periodKey + '_' + data.taskId
        && data.count is int
        && data.count >= 0
        && data.count <= maxCountFor(data.taskId)
        && (data.value == null
            || (data.value is number && data.value >= 0 && data.value <= 1000000000))
        && data.updatedAt is timestamp;
    }

    function isValidBoss(data) {
      return data.keys().hasOnly(['name', 'difficulty', 'order', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 20
        && data.difficulty in ['easy', 'normal', 'hard', 'chaos', 'extreme']
        && data.order is int
        && data.order >= 0
        && data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /characters/{characterId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidCharacter(request.resource.data);
        // 이름만 바꿀 수 있다 (게임·생성일은 변경 불가)
        allow update: if isOwner(uid)
          && isValidCharacter(request.resource.data)
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.createdAt == resource.data.createdAt;

        // 숙제 진행 기록: 주기·숙제당 문서 하나, 값 범위 검증
        match /checks/{checkId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && isValidCheck(request.resource.data, checkId);
        }

        // 주간 보스 목록: 이름·난이도·순서만 바꿀 수 있다 (생성일은 변경 불가)
        // ※ 캐릭터당 12개 제한은 앱(BossService)에서 검사한다 (Rules 로는 문서 개수를 셀 수 없음)
        match /bosses/{bossId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && isValidBoss(request.resource.data);
          allow update: if isOwner(uid)
            && isValidBoss(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt;
        }
      }
    }
  }
}
